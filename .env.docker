# === Server ===
PORT=8080

# === Database (MySQL) ===
# Option 1: Individual components (recommended for Docker/K8s/PaaS)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=bookify
DB_USER=bookify_user
DB_PASSWORD=bookify_secure_password

# Option 2: Full DSN (Go mysql driver format)
# DATABASE_URL=bookify_user:password@tcp(127.0.0.1:3306)/bookify?parseTime=true&charset=utf8mb4

# Option 3: PaaS often injects only host:port — set credentials via DB_* above
# DATABASE_URL=db-service.internal:3306

# Option 4: Standard mysql URL (also supported)
# MYSQL_URL=mysql://bookify_user:password@127.0.0.1:3306/bookify

# === JWT ===
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=168h

# === File Upload ===
UPLOADS_DIR=./uploads
BASE_URL=http://localhost:8080

# === CORS ===
ALLOWED_ORIGINS=*

# === Default Superadmin ===
SUPERADMIN_EMAIL=superadmin@bookify.local
SUPERADMIN_PASSWORD=change-this-immediately-in-production
